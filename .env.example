# ═══════════════════════════════════════════════════════════════
# FounderAI v5.5.4 — Modelo de Configuração de Ambiente (.env.example)
# ═══════════════════════════════════════════════════════════════
#
# Copie este arquivo para `.env` na raiz do projeto e preencha com suas chaves:
#   cp .env.example .env
#
# NUNCA commite o `.env` com chaves reais no repositório.
# ═══════════════════════════════════════════════════════════════

# ── Provedores LLM (primário + fallback) ──
# Valores válidos: openrouter | gemini | groq | openai | anthropic | local | mock
PRIMARY_PROVIDER="groq"
FALLBACK_PROVIDER="local"
LLM_TIMEOUT_SECONDS=60.0
LLM_LOCAL_TIMEOUT_SECONDS=360
COUNCIL_ASSUME_DEFAULTS=false
LLM_HTTP_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5

# ── Ordem de providers (v5.5.4) ──
# Vazio = cadeia legada [PRIMARY, FALLBACK].
# Preenchido = multi-gateway com fallback cloud-first em 429.
# Exemplo: openrouter,gemini,groq,local
LLM_PROVIDER_ORDER=

# ── Overrides por papel (opcional) ──
# Se preenchidos, Architect/SecurityCoder/ProductStrategist usam provider específico.
ARCHITECT_PROVIDER=""
SECURITYCODER_PROVIDER=""
PRODUCTSTRATEGIST_PROVIDER=""

# ── Chaves de API (preencha no .env, NUNCA commite) ──
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Provedores de busca (Evidence Graph v5.2) ──
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Endpoints ──
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_BASE_URL="https://api.openai.com/v1"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ── Modelos ──
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-1.5-flash"
COUNCIL_MODEL="gemma2:2b"

# ── Contexto ──
MAX_FILE_CHARS=15000
MAX_TOTAL_CONTEXT_CHARS=40000

# ── Cache de evidências (v5.2) ──
EVIDENCE_CACHE_ENABLED=true
EVIDENCE_CACHE_TTL_SECONDS=86400
EVIDENCE_CACHE_BYPASS=false

# ── Sandbox & Análise Estática ──
SANDBOX_ENABLED=true
SANDBOX_IMAGE="founderai-sandbox-python:v1"
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MAX_OUTPUT_BYTES=1048576

STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_MYPY_ENABLED=true
STATIC_ANALYSIS_MAX_CYCLES=2
STATIC_ANALYSIS_TIMEOUT_SECONDS=30.0

# ── Escalation Webhook ──
ESCALATION_WEBHOOK_ENABLED=false
ESCALATION_WEBHOOK_URL=""
ESCALATION_WEBHOOK_PROVIDER="generic"
ESCALATION_WEBHOOK_TIMEOUT_SECONDS=8

# ── BUILD Mode (v4.x) ──
BUILD_MODE_ENABLED=true
BUILD_DEFAULT_PROJECT_TYPE="WEB_APP"
BUILD_DEFAULT_DEPLOYMENT_STRATEGY="PRIVATE"
BUILD_ARTIFACTS_DIR="artifacts/build"

# ── BUILD Game 2D ──
BUILD_GAME_ENABLED=true
BUILD_GAME_ENGINE="pygame"
BUILD_GAME_HEADLESS=true

# ── VALIDATE Mode (v4.x) ──
VALIDATE_MODE_ENABLED=true
VALIDATE_ARTIFACTS_DIR="artifacts/validate"
VALIDATE_DEFAULT_VERDICT_IF_UNCERTAIN="INVESTIGATE"

# ── VALIDATE_AND_BUILD (v4.x) ──
VALIDATE_AND_BUILD_ENABLED=true
VAB_REQUIRE_HUMAN_CONFIRMATION=true
VAB_MIN_CONFIDENCE_TO_AUTOBUILD=0.75
VAB_ARTIFACTS_DIR="artifacts/validate_and_build"

# ── SELF-AUDIT (v4.x) ──
SELF_AUDIT_ENABLED=true
SELF_AUDIT_MAX_MISSIONS_PER_MODE=3
SELF_AUDIT_ADVERSARIAL_ENABLED=true
SELF_AUDIT_ARTIFACTS_DIR="artifacts/self_audit"
SELF_AUDIT_AUDITOR_PROVIDER="ollama"
SELF_AUDIT_AUDITOR_MODEL="llama3.1:8b"

# ── DISCOVER (v4.x) ──
DISCOVER_MODE_ENABLED=true
DISCOVER_MAX_OPPORTUNITIES=8
DISCOVER_INTERNAL_CANDIDATES=16
DISCOVER_ARTIFACTS_DIR="artifacts/discover"
DISCOVER_HANDOFF_TO_VALIDATE=true

# ── Golden Missions (v5.0) ──
GOLDEN_ENABLED=true
GOLDEN_ARTIFACTS_DIR="artifacts/golden"

# ── Project Memory (v5.3) ──
PROJECT_MEMORY_ENABLED=true
PROJECT_MEMORY_BACKEND="disk"
PROJECT_MEMORY_DIR="artifacts/projects"
PROJECT_MEMORY_CONTEXT_MAX_CHARS=8000

# ── IMPROVE Mode (v5.4) ──
IMPROVE_MODE_ENABLED=true
IMPROVE_MAX_FILES_TOUCHED=8
IMPROVE_MAX_RETRIES=2

# ── OBSERVE Feedback (v5.5) ──
OBSERVE_FEEDBACK_ENABLED=true
OBSERVE_FEEDBACK_MAX_NOTE_CHARS=2000

# ── Legado / Infra ──
OLLAMA_TIMEOUT=60.0
MODEL_PRIMARY="gemma2:2b"
MODEL_REASONING="gemma2:2b"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="fundador_ia"
POSTGRES_USER="fundador"
POSTGRES_PASSWORD="fundador"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="missions"
APP_NAME="Fundador IA"
APP_VERSION="5.5.4"
DEBUG=false