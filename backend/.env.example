# ═══════════════════════════════════════════════════════════════
# FounderAI v5.0.0 GA — Configuração de Ambiente (.env.example)
# Copie para `.env` e preencha. Variáveis ausentes geram avisos claros.
# ═══════════════════════════════════════════════════════════════

# ── Provedores LLM (primário + fallback) ──
PRIMARY_PROVIDER="groq"            # groq | openrouter | openai | local
FALLBACK_PROVIDER="local"          # rede de segurança automática
LLM_TIMEOUT_SECONDS=60.0
LLM_LOCAL_TIMEOUT_SECONDS=180.0    # codegen local é lento (mín. 120)
LLM_HTTP_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5

# ── Overrides por papel (opcional) ──
ARCHITECT_PROVIDER=""
SECURITYCODER_PROVIDER=""
PRODUCTSTRATEGIST_PROVIDER=""

# ── Chaves de API (essenciais p/ provedores Cloud) ──
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."
OPENAI_API_KEY="sk-..."

# ── Endpoints ──
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_BASE_URL="https://api.openai.com/v1"
ollama_base_url="http://localhost:11434/v1"

# ── Modelos ──
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENAI_MODEL="gpt-4o-mini"
council_model="gemma2:2b"

# ── Contexto ──
MAX_FILE_CHARS=15000
MAX_TOTAL_CONTEXT_CHARS=40000

# ── Sandbox (v4.0) ──
SANDBOX_ENABLED=true
SANDBOX_IMAGE="founderai-sandbox-python:v1"
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MAX_OUTPUT_BYTES=1048576

# ── Pre-Sandbox Guardrail (v4.1) ──
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_MYPY_ENABLED=true
STATIC_ANALYSIS_MAX_CYCLES=2
STATIC_ANALYSIS_TIMEOUT_SECONDS=30.0

# ── Escalation Webhook (v4.1) ──
ESCALATION_WEBHOOK_ENABLED=false
ESCALATION_WEBHOOK_URL=""
ESCALATION_WEBHOOK_PROVIDER="generic"
ESCALATION_WEBHOOK_TIMEOUT_SECONDS=8

# ── BUILD Mode (v4.2) ──
BUILD_MODE_ENABLED=true
BUILD_DEFAULT_PROJECT_TYPE="WEB_APP"
BUILD_DEFAULT_DEPLOYMENT_STRATEGY="PRIVATE"
BUILD_ARTIFACTS_DIR="artifacts/build"

# ── BUILD Game 2D (v4.3) ──
BUILD_GAME_ENABLED=true
BUILD_GAME_ENGINE="pygame"
BUILD_GAME_HEADLESS=true

# ── VALIDATE Mode (v4.4) ──
VALIDATE_MODE_ENABLED=true
VALIDATE_ARTIFACTS_DIR="artifacts/validate"
VALIDATE_DEFAULT_VERDICT_IF_UNCERTAIN="INVESTIGATE"

# ── VALIDATE_AND_BUILD (v4.5) ──
VALIDATE_AND_BUILD_ENABLED=true
VAB_REQUIRE_HUMAN_CONFIRMATION=true
VAB_MIN_CONFIDENCE_TO_AUTOBUILD=0.75
VAB_ARTIFACTS_DIR="artifacts/validate_and_build"

# ── SELF-AUDIT (v4.6) ──
SELF_AUDIT_ENABLED=true
SELF_AUDIT_MAX_MISSIONS_PER_MODE=3
SELF_AUDIT_ADVERSARIAL_ENABLED=true
SELF_AUDIT_ARTIFACTS_DIR="artifacts/self_audit"
SELF_AUDIT_AUDITOR_PROVIDER="ollama"
SELF_AUDIT_AUDITOR_MODEL="llama3.1:8b"

# ── DISCOVER (v4.7) ──
DISCOVER_MODE_ENABLED=true
DISCOVER_MAX_OPPORTUNITIES=8
DISCOVER_INTERNAL_CANDIDATES=16
DISCOVER_ARTIFACTS_DIR="artifacts/discover"
DISCOVER_HANDOFF_TO_VALIDATE=true

# ── Golden Missions (v5.0 GA) ──
GOLDEN_ENABLED=true
GOLDEN_ARTIFACTS_DIR="artifacts/golden"

# ── Legado / infra ──
ollama_timeout=60.0
model_primary="gemma2:2b"
model_reasoning="gemma2:2b"
postgres_host="localhost"
postgres_port=5432
postgres_db="fundador_ia"
postgres_user="fundador"
postgres_password="fundador"
qdrant_host="localhost"
qdrant_port=6333
qdrant_collection="missions"
app_name="Fundador IA"
app_version="5.0.0"
debug=false

# Provedores reais de busca (v5.2.1)
TAVILY_API_KEY=""      # https://tavily.com — IA-first search
SERPER_API_KEY=""      # https://serper.dev — Google Search API