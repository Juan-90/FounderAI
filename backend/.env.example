# ═══════════════════════════════════════════════════════════════
# FounderAI v3.5 — Configuração de Ambiente (.env.example)
# Copie este arquivo para `.env` e preencha os valores.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# PROVEDORES LLM (Fase 2 — Arquitetura Híbrida)
# ───────────────────────────────────────────────────────────────

# Provedor principal (usado por padrão em todos os jurados).
# Valores aceitos: "groq" | "openrouter" | "openai" | "local"
PRIMARY_PROVIDER="groq"

# Provedor de fallback (usado automaticamente se o primário falhar).
# Valores aceitos: "groq" | "openrouter" | "openai" | "local"
FALLBACK_PROVIDER="local"

# Timeout global de inferência em segundos (por chamada).
LLM_TIMEOUT_SECONDS=60.0

# ───────────────────────────────────────────────────────────────
# OVERRIDE POR PAPEL (Opcional)
# Deixe em branco para usar o PRIMARY_PROVIDER.
# ───────────────────────────────────────────────────────────────
ARCHITECT_PROVIDER=""
SECURITYCODER_PROVIDER=""
PRODUCTSTRATEGIST_PROVIDER=""

# ───────────────────────────────────────────────────────────────
# CHAVES DE API (Obrigatórias apenas se o provedor for Cloud)
# ───────────────────────────────────────────────────────────────

# Groq (https://console.groq.com/keys) — recomendado para testes
GROQ_API_KEY="gsk_..."

# OpenRouter (https://openrouter.ai/keys) — multi-provider
OPENROUTER_API_KEY="sk-or-..."

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# ───────────────────────────────────────────────────────────────
# ENDPOINTS E MODELOS
# ───────────────────────────────────────────────────────────────

# Endpoints base (compatíveis com a API OpenAI)
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Endpoint local (Ollama / vLLM / LM Studio)
ollama_base_url="http://localhost:11434/v1"

# Modelos padrão por provedor (podem ser sobrescritos via role overrides)
# Groq:    "llama-3.3-70b-versatile" | "llama-3.1-8b-instant"
# OpenRouter: "openai/gpt-4o-mini" | "anthropic/claude-3.5-sonnet"
# OpenAI:  "gpt-4o-mini" | "gpt-4o"
# Local:   nome do modelo baixado via `ollama pull <modelo>`

# ───────────────────────────────────────────────────────────────
# LIMITES DE CONTEXTO (Fase 3 — Bloco 1)
# ───────────────────────────────────────────────────────────────

# Máximo de caracteres por arquivo individual (arquivos maiores são truncados).
MAX_FILE_CHARS=15000

# Máximo total de caracteres para o contexto injetado no prompt.
MAX_TOTAL_CONTEXT_CHARS=40000

# ───────────────────────────────────────────────────────────────
# OLLAMA LOCAL (Legado Fase 1 + Fallback)
# ───────────────────────────────────────────────────────────────
ollama_timeout=60.0
council_model="gemma2:2b"
model_primary="gemma2:2b"
model_reasoning="gemma2:2b"

# ───────────────────────────────────────────────────────────────
# POSTGRESQL (Persistência de histórico)
# ───────────────────────────────────────────────────────────────
postgres_host="localhost"
postgres_port=5432
postgres_db="fundador_ia"
postgres_user="fundador"
postgres_password="fundador"

# ───────────────────────────────────────────────────────────────
# QDRANT (Vector store de missões)
# ───────────────────────────────────────────────────────────────
qdrant_host="localhost"
qdrant_port=6333
qdrant_collection="missions"

# ───────────────────────────────────────────────────────────────
# APP
# ───────────────────────────────────────────────────────────────
app_name="Fundador IA"
app_version="0.2.0"
debug=false