# ═══════════════════════════════════════════════════════════════
# FounderAI v4.1.0 — Configuração de Ambiente (.env.example)
# Copie para `.env` e preencha.
# ═══════════════════════════════════════════════════════════════

# ── Provedores LLM ──
PRIMARY_PROVIDER="groq"
FALLBACK_PROVIDER="local"
LLM_TIMEOUT_SECONDS=60.0
ARCHITECT_PROVIDER=""
SECURITYCODER_PROVIDER=""
PRODUCTSTRATEGIST_PROVIDER=""

# ── Chaves de API ──
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-..."
OPENAI_API_KEY="sk-..."

# ── Endpoints ──
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_BASE_URL="https://api.openai.com/v1"
ollama_base_url="http://localhost:11434/v1"

# ── Modelos ──
GROQ_MODEL="openai/gpt-oss-20b"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENAI_MODEL="gpt-4o-mini"
council_model="gemma2:2b"

# ── Contexto ──
MAX_FILE_CHARS=15000
MAX_TOTAL_CONTEXT_CHARS=40000

# ── Sandbox (v4.0) ──
SANDBOX_ENABLED=true
SANDBOX_IMAGE="founderai-sandbox-python:v1"
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MAX_OUTPUT_BYTES=1048576

# ── Pre-Sandbox Guardrail (v4.1.0 Módulo A) ──
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_MYPY_ENABLED=true
STATIC_ANALYSIS_MAX_CYCLES=2
STATIC_ANALYSIS_TIMEOUT_SECONDS=30.0

# ── Escalation Webhook (v4.1.0 Módulo C) ──
ESCALATION_WEBHOOK_ENABLED=false
ESCALATION_WEBHOOK_URL=""
ESCALATION_WEBHOOK_PROVIDER="generic"
ESCALATION_WEBHOOK_TIMEOUT_SECONDS=8

# ── Legado ──
ollama_timeout=60.0
model_primary="gemma2:2b"
model_reasoning="gemma2:2b"
postgres_host="localhost"
postgres_port=5432
postgres_db="fundador_ia"
postgres_user="fundador"
postgres_password="fundador"
qdrant_host="localhost"
qdrant_port=6333
qdrant_collection="missions"
app_name="Fundador IA"
app_version="0.2.0"
debug=false